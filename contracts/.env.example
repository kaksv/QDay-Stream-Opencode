# Deployer environment for contracts/script/Deploy.s.sol
# Copy to contracts/.env and chmod 600. Never commit the real key.

# Required: a funded Aevum deployer key.
PRIVATE_KEY=

# Safety rail: the script refuses to deploy to any other chain.
EXPECTED_CHAIN_ID=44005

# Optional: defaults to the official tUSD8 on Aevum.
# TOKEN_ADDRESS=0x456569838f1d43009A91ebA4263147Afd7233483

# Optional: write deployments/*.json after a successful broadcast.
WRITE_DEPLOYMENT=true
