# ---------------------------------------------------------------------------
# StreamPay web app — copy to web/.env.local for local development.
# All NEXT_PUBLIC_* values are PUBLIC and baked into the browser bundle.
# Never put a private key in a NEXT_PUBLIC_* variable.
# ---------------------------------------------------------------------------

# "local" reads web/lib/deployments/local.json and http://127.0.0.1:8545.
# Leave unset (or "aevum") for QDay Aevum Testnet.
# NEXT_PUBLIC_DEPLOYMENT=local

# Override the deployment record. Required for production builds if the
# checked-in deployment file still has the zero placeholder.
# NEXT_PUBLIC_STREAMPAY_ADDRESS=0x...

# Official QDay tUSD8 token. Only override for local/test deployments.
# NEXT_PUBLIC_TOKEN_ADDRESS=0x456569838f1d43009A91ebA4263147Afd7233483

# RPC endpoint. Defaults to https://rpc-test.qday.info (or Anvil when local).
# NEXT_PUBLIC_RPC_URL=https://rpc-test.qday.info

# Public app URL, used for metadata, OG tags, share links and sitemap.
# NEXT_PUBLIC_APP_URL=https://streampay.example

# Enable the unlocked Anvil demo connector (#local only). Never enable in
# production: anyone could act as the demo account.
# NEXT_PUBLIC_DEMO_WALLET=1
# NEXT_PUBLIC_DEMO_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
